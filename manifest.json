{
    "manifest_version": 2,
    "name": "GDPS Hub Image Tracker Remover",
    "developer": {
        "name": "M336",
        "url": "https://m336.dev/"
    },
    "description": "Avoid leaking your IP when checking a GDPS page by proxying all images potentially displayed on it",
    "version": "1.0.1",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "*://*.gdpshub.com/*",
        "*://*/*"
    ],
    "background": {
        "scripts": [ "background.js" ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "gdpshub-image-tracker-remover@m336.dev",
            "data_collection_permissions": { "required": ["none"] }
        }
    }
}